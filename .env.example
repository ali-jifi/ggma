# ggma — copy to .env and fill in.  `cp .env.example .env`
#
# .env is git-ignored and must stay that way: it holds the hub password.
# Also loaded, if present: safety/jupyterhub/.env (machine-local overrides on the
# hub box). Anything exported in your shell beats both.
#
# Every other setting has a working default. They are listed, with what they do, in
# safety/jupyterhub/README.md — add one here only when you need to change it.


# --- JupyterHub: the three values from the research program's email ------------
# URL is what you would type into a browser, without a trailing path.
JUPYTERHUB_URL=
JUPYTERHUB_USER=
JUPYTERHUB_PASSWORD=

# Optional, and better than the password once you are in: an API token from the hub
# UI (File -> Hub Control Panel -> Token). Required for `run.sh hub start|stop`, and
# the only option if your hub logs in through SSO rather than a password form.
JUPYTERHUB_TOKEN=


# --- HuggingFace --------------------------------------------------------------
# Optional: the models we use are ungated, so a token only avoids anonymous rate
# limits. But putting it HERE is the more robust of the two options on the hub.
#
# The alternative is `huggingface-cli login`, which stores the token at
# $HF_HOME/token — and HF_HOME is exactly the thing you move to the scratch disk on
# a hub box (the 13B judge is ~26GB, $HOME is usually quota'd). Log in first, move
# HF_HOME afterwards, and the login silently stops applying. A token in .env does
# not move.
HF_TOKEN=


# --- Which GPUs this process may touch ----------------------------------------
# nvidia-smi indices. We agreed on 4,5 so runs do not land on each other's cards;
# this is enforced (pinned before torch loads, refuses a card that is already busy,
# verifies GPU UUIDs afterwards). 'all' leaves the selection alone; 'cpu' hides CUDA.
SAFETY_GPUS=4,5
